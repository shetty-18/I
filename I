10. Develop a water level depth detection system

Reference

Ultrasonic Sensor → Arduino

VCC  → 5V
TRIG → 9
ECHO → 10
GND  → GND

Variables

long duration;
float distance;
float tankHeight = 30.0;
float waterLevel;

Program

void setup() {
  pinMode(9, OUTPUT);
  pinMode(10, OUTPUT);
  pinMode(13, OUTPUT);

  Serial.begin(9600);
  Serial.println("Water Level Detection System");
}

void loop() {
  digitalWrite(9, LOW);
  delayMicroseconds(2);

  digitalWrite(9, HIGH);
  delayMicroseconds(10);

  digitalWrite(9, LOW);

  duration = pulseIn(10, HIGH);

  distance = duration * 0.03432;

  waterLevel = tankHeight - distance;

  Serial.print("Distance from sensor: ");
  Serial.print(distance);
  Serial.println(" cm");

  Serial.print("Water Level: ");
  Serial.print(waterLevel);
  Serial.println(" cm");

  if (waterLevel < 10) {
    Serial.println("Water Level LOW");
    digitalWrite(13, HIGH);
  } else {
    Serial.println("Water Level NORMAL");
    digitalWrite(13, LOW);
  }

  delay(1000);
}

