10) Develop a program to set up a UART protocol and pair Arduino through the protocol

Connection

        Arduino UNO              Arduino UNO
             TX  ──────────────── RX
             RX  ──────────────── TX
            GND  ─────────────── GND

Sender Code

void setup()
{
  Serial.begin(9600);
}

void loop()
{
  Serial.println("Hello from Arduino!");
  delay(1000);
}

Receiver Code

void setup()
{
  Serial.begin(9600);
  Serial.setTimeout(1000);
}

void loop()
{
  if (Serial.available())
  {
    String receivedString = Serial.readStringUntil('\n');

    Serial.println("Arduino Received:");
    Serial.println(receivedString);
  }
}

