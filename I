6) Moisture Sensor

Question: Develop a program to classify dry and wet soil with the moisture sensor.

Program

int moisture_value;
float moisture_percentage;

void setup()
{
  pinMode(6, OUTPUT);
  pinMode(7, OUTPUT);

  Serial.begin(9600);
}

void loop()
{
  moisture_value = analogRead(A0);

  moisture_percentage =
    ((moisture_value / 539.00) * 100);

  if (moisture_percentage < 100)
  {
    digitalWrite(6, HIGH);
    digitalWrite(7, LOW);
  }
  else
  {
    digitalWrite(6, LOW);
    digitalWrite(7, HIGH);
  }

  Serial.println("Moisture Value:");
  Serial.println(moisture_percentage);

  delay(1000);
}

